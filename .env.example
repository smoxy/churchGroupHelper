# Telegram Bot Configuration
BOT_TOKEN=your_telegram_bot_token_here

# Admin user IDs, comma-separated - these users can manage the bot
ADMINS=123456789,987654321

# Docker Configuration
CONTAINER_NAME=churchgroupbot
WORK_DIR=/path/to/your/project

# AI Services Configuration
# Priority: If OPENAI_API_KEY is set, OpenAI is used. Otherwise, Ollama is used.
# OPENAI_API_KEY=sk-your-openai-api-key-here

# OpenAI model selection (optional, defaults shown below)
# OPENAI_MODEL=gpt-5-nano

# === Ollama Configuration (Default) ===
# Ollama Cloud API key for conversation summarization and transcription improvement
# Get your API key from: https://ollama.com
OLLAMA_API_KEY=your_ollama_cloud_api_key_here

# Ollama base URL (default: https://ollama.com)
# OLLAMA_BASE_URL=https://ollama.com

# Ollama model selection (optional, defaults shown below)
# Available models: gpt-oss:20b, gpt-oss:120b, kimi-k2:1t, deepseek-v3.1:671b
# OLLAMA_MODEL=gpt-oss:20b

# === AI Provider Override (Optional) ===
# Force a specific provider regardless of API keys
# Options: openai, ollama
# If not set, auto-detects based on OPENAI_API_KEY presence
# AI_PROVIDER=ollama

# === Transcription Improvement Configuration ===
# Model for transcription quality improvement (optional)
# If using OpenAI: gpt-5-nano (recommended for speed/cost)
# If using Ollama: gpt-oss:20b (default)
# Larger models = better quality but slower and more expensive
TRANSCRIPTION_IMPROVER_MODEL=gpt-oss:20b

# ASR Service Configuration (Parakeet container, see ai/parakeet/)
# The bot connects to an external ASR service for audio transcription.
# The service publishes port 9000 on the host.

# Option 1: Use full URI (recommended)
# Example via host IP:   http://192.168.1.11:9000
# Example for localhost: http://localhost:9000
# Example for Docker network: http://parakeet:9000
WHISPER_SERVICE_URI=http://parakeet:9000

# === Biblical texts import ===
# Use `/importbiblicaltexts` to upload the complete set of biblical texts for one or more groups.
# The CSV must include the columns:
# reference,text,version,theme,age_min,age_max,gender_preference
#
# The `version` column indicates the translation (es. CEI2008, NR, RVR1960). `language` defaults to `it`.
# The command replaces the existing texts for the selected groups, so upload the dataset you intend to use.
# If `version` is omitted, the default translation is read from `BIBLICAL_TEXTS_DEFAULT_VERSION`.
# Default translation version for CSV imports (fallback to CEI2008 if unset)
BIBLICAL_TEXTS_DEFAULT_VERSION=CEI2008

# Option 2: Use separate host and port (only if WHISPER_SERVICE_URI is not set)
# WHISPER_SERVICE_HOST=parakeet
# WHISPER_SERVICE_PORT=9000

# Logging Configuration
# Set the logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO