# Telegram Bot Configuration
BOT_TOKEN=your_telegram_bot_token_here

# Admin user IDs, comma-separated - these users can manage the bot
ADMINS=123456789,987654321

# Docker Configuration
CONTAINER_NAME=churchgroupbot
WORK_DIR=/path/to/your/project

# AI Services Configuration
# Ollama Cloud API key for conversation summarization and transcription improvement
# Get your API key from: https://ollama.com
OLLAMA_API_KEY=your_ollama_cloud_api_key_here

# Model for transcription quality improvement (optional)
# Default: gpt-oss:20b
# Options: gpt-oss:20b, gpt-oss:120b, kimi-k2:1t, deepseek-v3.1:671b
# Larger models = better quality but slower and more expensive
TRANSCRIPTION_IMPROVER_MODEL=gpt-oss:20b

# Whisper ASR Service Configuration
# The bot connects to an external Whisper service for audio transcription
# See EXTERNAL_WHISPER_SERVICE.md for setup instructions

# Option 1: Use full URI (recommended)
# Example for Docker network: http://whisper-service:9000
# Example for localhost: http://localhost:9000
WHISPER_SERVICE_URI=http://whisper-service:9000

# Option 2: Use separate host and port (only if WHISPER_SERVICE_URI is not set)
# WHISPER_SERVICE_HOST=whisper-service
# WHISPER_SERVICE_PORT=9000
